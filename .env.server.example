# ============================================================
# ШАБЛОН .env ДЛЯ СЕРВЕРА (Timeweb VPS — n8n.24isk.ru)
# ============================================================
# Как пользоваться:
#   1. Скопируй этот файл НА СЕРВЕР:  .env.server.example → .env
#      (обычно рядом с docker-compose n8n, например /opt/n8n/.env)
#   2. Вставь реальные значения вместо ПУСТЫХ мест после "=".
#      Локальный источник значений — C:\AI moy\test 1 moy\.env
#   3. Ограничь права:  chmod 600 .env
#   4. НИКОГДА не коммить заполненный файл. В git идёт только этот
#      шаблон (.env.server.example) — реальные .env.* в .gitignore.
#
# ВАЖНО: после утечки 2026-06 ключи ротированы (scripts/rotate_n8n_key.py).
# Вставляй НОВЫЕ значения, не старые из бэкапов.
# ============================================================

# ---------- n8n ----------
N8N_URL=https://n8n.24isk.ru
N8N_API_KEY=

# ---------- Telegram-боты ----------
TELEGRAM_BOT_PHOTO2VIDEO=
TELEGRAM_BOT_COLLECT=
TELEGRAM_BOT_ISKPHOTOALIVE=
TELEGRAM_BOT_TWODTRAID=
CONTROL_TG_TOKEN=
TG_CHANNEL_HANDLE=
TG_CHANNEL_CHAT_ID=
ADMIN_TG_CHAT_ID=

# ---------- Платежи (ЮKassa) ----------
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# ---------- PostgreSQL ----------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---------- AI-провайдеры (генерация видео) ----------
OPENAI_API_KEY=
AIMLAPI_API_KEY=
HAILUO_API_KEY=
PIAPI_KEY=

# ---------- Wildberries ----------
WB_API_KEY_MAIN=
WB_API_KEY_2D=

# ---------- Google OAuth (Sheets / Drive / Gmail) ----------
GOOGLE_SHEETS_OAUTH_CLIENT_ID=
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# ---------- Яндекс ----------
YANDEX_OAUTH_TOKEN=
YANDEX_DISK_OAUTH_TOKEN=
YANDEX_IMAP_EMAIL=
YANDEX_IMAP_PASSWORD=
YANDEX_DIRECT_CLIENT_ID=
YANDEX_DIRECT_CLIENT_SECRET=

# ---------- Яндекс.Метрика (счётчик + цели) ----------
YANDEX_METRIKA_COUNTER_ID=109293181
YANDEX_GOAL_PHOTO_UPLOADED=
YANDEX_GOAL_GENERATION_STARTED=
YANDEX_GOAL_FREE_GEN_COMPLETED=
YANDEX_GOAL_PAID_GEN_COMPLETED=
YANDEX_GOAL_GEN_FAILED=
YANDEX_GOAL_PAYMENT_OPEN=
YANDEX_GOAL_PAYMENT_REDIRECT=
YANDEX_GOAL_PAYMENT_SUCCESS=
YANDEX_GOAL_VIDEO_DOWNLOAD=

# ---------- YouTube ----------
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_UPLOADS_PLAYLIST=

# ---------- Дашборд (https://n8n.24isk.ru/op/) ----------
DASHBOARD_URL=
DASHBOARD_USER=
DASHBOARD_PASSWORD=
SET_BASELINE_TOKEN=

# ---------- Timeweb API ----------
TIMEWEB_TOKEN=

# ---------- GitHub (если серверу нужен доступ к репо) ----------
GITHUB_USER=
GITHUB_EMAIL=
GITHUB_TOKEN=

# ============================================================
# НЕ переносить на сервер (нужны только на локальной машине):
#   VPS_HOST, VPS_USER, VPS_SSH_PASSWORD, VPS_SSH_KEY —
#   это доступы К серверу, держать их НА сервере незачем.
# ============================================================
